+		// Texto comparable: sin '&', sin atajo tras '\t', sin espacios extremos, en minusculas.
+		static std::wstring normalize_title(const wchar_t *s)
+		{
+			std::wstring w = s ? s : L"";
+			std::erase(w, L'&');
+			if(auto p = w.find(L'\t'); p != std::wstring::npos)
+				w.resize(p);
+			while(!w.empty() && iswspace(w.back())) w.pop_back();
+			size_t b = 0;
+			while(b < w.size() && iswspace(w[b])) b++;
+			w.erase(0, b);
+			for(auto &ch : w) ch = (wchar_t)towlower(ch);
+			return w;
+		}
+
+		// ------------------------------------------------------------------
+		// excmd: ejecuta un comando de Windows 11 (IExplorerCommand) por CLSID
+		// sobre la seleccion. Sirve para comandos que el programa solo muestra
+		// en el menu moderno (p. ej. "Combine archivos en Acrobat...").
+		//   excmd='{CLSID}'          -> el comando (o su primer subcomando)
+		//   excmd='{CLSID}|texto'    -> el subcomando cuyo titulo empieza con texto
+		// ------------------------------------------------------------------
+		static bool invoke_explorer_command(const string &spec, const std::vector<Selections::PathItem *> &sel)
+		{
+			std::wstring s = spec.c_str();
+			std::wstring clsid_str = s, sub;
+			if(auto p = s.find(L'|'); p != std::wstring::npos)
+			{
+				clsid_str = s.substr(0, p);
+				sub = normalize_title(s.substr(p + 1).c_str());
+			}
+			while(!clsid_str.empty() && iswspace(clsid_str.back())) clsid_str.pop_back();
+			while(!clsid_str.empty() && iswspace(clsid_str.front())) clsid_str.erase(0, 1);
+
+			CLSID clsid{};
+			if(FAILED(::CLSIDFromString(clsid_str.c_str(), &clsid)))
+				return false;
+
+			const HRESULT hrInit = ::CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED);
+			bool ok = false;
+			{
+				std::vector<PIDLIST_ABSOLUTE> pidls;
+				for(auto it : sel)
+				{
+					if(!it || it->Path.empty()) continue;
+					PIDLIST_ABSOLUTE pidl = nullptr;
+					if(SUCCEEDED(::SHParseDisplayName(it->Path.c_str(), nullptr, &pidl, 0, nullptr)) && pidl)
+						pidls.push_back(pidl);
+				}
+
+				// la API pide un arreglo de punteros const: se copia a ese tipo
+				std::vector<PCIDLIST_ABSOLUTE> cpidls(pidls.begin(), pidls.end());
+
+				IShellItemArray *arr = nullptr;
+				if(!cpidls.empty() &&
+				   SUCCEEDED(::SHCreateShellItemArrayFromIDLists((UINT)cpidls.size(), cpidls.data(), &arr)) && arr)
+				{
+					IExplorerCommand *cmd = nullptr;
+					if(SUCCEEDED(::CoCreateInstance(clsid, nullptr, CLSCTX_LOCAL_SERVER | CLSCTX_INPROC_SERVER,
+						IID_IExplorerCommand, reinterpret_cast<void **>(&cmd))) && cmd)
+					{
+						IExplorerCommand *target = nullptr;
+						EXPCMDFLAGS flags = 0;
+						if(SUCCEEDED(cmd->GetFlags(&flags)) && (flags & ECF_HASSUBCOMMANDS))
+						{
+							IEnumExplorerCommand *en = nullptr;
+							if(SUCCEEDED(cmd->EnumSubCommands(&en)) && en)
+							{
+								IExplorerCommand *c = nullptr;
+								ULONG fetched = 0;
+								while(!target && en->Next(1, &c, &fetched) == S_OK && c)
+								{
+									bool match = sub.empty();
+									if(!match)
+									{
+										LPWSTR title = nullptr;
+										if(SUCCEEDED(c->GetTitle(arr, &title)) && title)
+										{
+											auto t = normalize_title(title);
+											match = t.size() >= sub.size() && t.compare(0, sub.size(), sub) == 0;
+										}
+										if(title) ::CoTaskMemFree(title);
+									}
+									if(match) target = c;
+									else c->Release();
+									c = nullptr;
+								}
+								en->Release();
+							}
+						}
+						else
+						{
+							target = cmd;
+							target->AddRef();
+						}
+
+						if(target)
+						{
+							ok = SUCCEEDED(target->Invoke(arr, nullptr));
+							target->Release();
+						}
+						cmd->Release();
+					}
+					arr->Release();
+				}
+
+				for(auto p : pidls)
+					::ILFree(p);
+			}
+			if(SUCCEEDED(hrInit))
+				::CoUninitialize();
+			return ok;
+		}
+
+		void ContextMenu::invoke_excmd(NativeMenu *menu)
+		{
+			if(!menu || !menu->excmd) return;
+			string spec;
+			if(_context.Eval(menu->excmd, spec, true) && !spec.empty())
+				invoke_explorer_command(spec, Selected.Items);
+		}
