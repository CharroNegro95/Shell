+		// Busca en el menu original de Windows la entrada con ese id (id.share, id.edit...).
+		menuitem_t *ContextMenu::find_system_item(uint32_t uid) const
+		{
+			if(uid == 0) return nullptr;
+			for(auto it : __toolbar_sys_items)
+			{
+				if(it->uid() == uid || it->hash == uid)
+					return it;
+			}
+			return nullptr;
+		}
+
+		// Busca por texto: patrones separados por '|', en orden de preferencia.
+		// Un patron coincide si el titulo es igual o empieza con el (sin importar mayusculas);
+		// entre comillas ("Editar") solo coincide si el titulo es exactamente ese texto.
+		menuitem_t *ContextMenu::find_system_item_by_title(const string &patterns) const
+		{
+			const auto &all = __toolbar_sys_items;
+
+			std::wstring src = patterns.c_str();
+			size_t start = 0;
+			while(start <= src.size())
+			{
+				auto end = src.find(L'|', start);
+				if(end == std::wstring::npos) end = src.size();
+				auto pat = normalize_title(src.substr(start, end - start).c_str());
+				start = end + 1;
+
+				// "texto" entre comillas: el titulo debe ser exactamente ese texto
+				bool exact = false;
+				if(pat.size() >= 2 && pat.front() == L'"' && pat.back() == L'"')
+				{
+					exact = true;
+					pat = normalize_title(pat.substr(1, pat.size() - 2).c_str());
+				}
+				if(pat.empty()) continue;
+
+				for(auto it : all)
+				{
+					auto t = normalize_title(it->title.c_str());
+					if(exact ? (t == pat) : (t.size() >= pat.size() && t.compare(0, pat.size(), pat) == 0))
+						return it;
+				}
+			}
+			return nullptr;
+		}
+
+		// Llamado por el timer y por WM_ENTERIDLE: actualiza el boton bajo el cursor.
+		void ContextMenu::toolbar_track()
+		{
+			if(_toolbars.empty()) return;
+
+			POINT pt{};
+			if(!::GetCursorPos(&pt)) return;
+
+			for(auto tb : _toolbars)
+			{
+				if(!tb || !::IsMenu(tb->handle)) continue;
+
+				auto index = MENU::get_index(tb->handle, tb->wID);
+				if(index == MF_NOITEM) continue;
+
+				RECT rc{};
+				if(!::GetMenuItemRect(nullptr, tb->handle, index, &rc)) continue;
+
+				int hot = ::PtInRect(&rc, pt) ? toolbar_hit(tb, rc, pt) : -1;
+				if(hot == tb->toolbar.hot) continue;
+				tb->toolbar.hot = hot;
+				if(hot < 0) _tip.hide();
+
+				// ventana del menu que contiene la barra
+				HWND hwndMenu{};
+				if(auto it = map_menu_wnd.find(tb->handle); it != map_menu_wnd.end())
+					hwndMenu = it->second.hwnd;
+				if(!hwndMenu)
+				{
+					for(auto &w : _map)
+					{
+						if(w.second.hMenu == tb->handle) { hwndMenu = w.first; break; }
+					}
+				}
+
+				if(hwndMenu)
+				{
+					::MapWindowPoints(HWND_DESKTOP, hwndMenu, reinterpret_cast<POINT *>(&rc), 2);
+					::InvalidateRect(hwndMenu, &rc, FALSE);
+				}
+			}
+		}
+
+		void ContextMenu::toolbar_stop()
+		{
+			if(hwnd.owner)
+				::KillTimer(hwnd.owner, TOOLBAR_TIMER);
+			_toolbars.clear();
+		}
+
+		void ContextMenu::draw_toolbar(DC &dc, MenuItemInfo *tb, const RECT &rcRow)
+		{
+			std::vector<RECT> btns;
+			toolbar_layout(tb, rcRow, btns);
+
+			const long isz = tb->toolbar.size;
+			const long cell = tb->toolbar.cell;
+
+			for(int i = 0; i < (int)btns.size(); i++)
+			{
+				auto child = tb->toolbar.items[i];
+				const RECT b = btns[i];
+				const bool hot = (i == tb->toolbar.hot);
+				const bool disabled = child->visibility != Visibility::Enabled;
+
+				Color text_color = hot ? _theme.text.color.sel : _theme.text.color.nor;
+				if(disabled) text_color = hot ? _theme.text.color.sel_dis : _theme.text.color.nor_dis;
+
+				if(hot)
+				{
+					Color back = disabled ? _theme.back.color.sel_dis : _theme.back.color.sel;
+					Color border = disabled ? _theme.back.border.sel_dis : _theme.back.border.sel;
+					draw_rect(&dc, POINT{ b.left, b.top }, SIZE{ cell, cell }, back, border, _theme.back.radius);
+				}
+
+				auto image = &child->image;
+				if(hot && child->image_select.isvalid())
+					image = &child->image_select;
+
+				if(image->hbitmap)
+				{
+					DC memDC(::CreateCompatibleDC(dc), 1);
+					if(memDC)
+					{
+						if(memDC.select_bitmap(image->hbitmap))
+						{
+							const long w = image->size.cx > 0 ? image->size.cx : isz;
