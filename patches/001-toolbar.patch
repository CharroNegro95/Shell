+		// Rectangulos de los botones repartidos a lo ancho de la fila rc:
+		// la fila se divide en partes iguales (zones) y cada boton va centrado
+		// en la suya, asi la barra ocupa todo el ancho del menu.
+		void ContextMenu::toolbar_layout(const MenuItemInfo *tb, const RECT &rc, std::vector<RECT> &out, std::vector<RECT> *zones) const
+		{
+			out.clear();
+			if(zones) zones->clear();
+			const long n = (long)tb->toolbar.items.size();
+			if(n <= 0) return;
+
+			const long cell = tb->toolbar.cell;
+			const long left = rc.left + (long)_theme.back.margin.left;
+			const long right = rc.right - (long)_theme.back.margin.right;
+			const long y = rc.top + ((rc.bottom - rc.top) - cell) / 2;
+
+			long slot = (right - left) / n;
+			if(slot < cell) slot = cell;
+
+			for(long i = 0; i < n; i++)
+			{
+				const long zl = left + i * slot;
+				// sin std::max: windows.h define la macro max y rompe la llamada
+				const long zr = (i == n - 1 && right > zl + slot) ? right : zl + slot;
+				const long x = zl + ((zr - zl) - cell) / 2;
+				out.push_back(RECT{ x, y, x + cell, y + cell });
+				if(zones) zones->push_back(RECT{ zl, rc.top, zr, rc.bottom });
+			}
+		}
+
+		// Boton cuya zona contiene pt; -1 si ninguno.
+		int ContextMenu::toolbar_hit(const MenuItemInfo *tb, const RECT &rc, POINT pt) const
+		{
+			if(pt.y < rc.top || pt.y >= rc.bottom) return -1;
+			std::vector<RECT> btns, zones;
+			toolbar_layout(tb, rc, btns, &zones);
+			for(int i = 0; i < (int)zones.size(); i++)
+			{
+				if(pt.x >= zones[i].left && pt.x < zones[i].right)
+					return i;
+			}
+			return -1;
+		}
+
+		// Busca en el menu original de Windows la entrada con ese id (id.share, id.edit...).
+		menuitem_t *ContextMenu::find_system_item(uint32_t uid) const
+		{
+			if(!__system_menu_tree || uid == 0) return nullptr;
+			std::vector<menuitem_t *> stack(__system_menu_tree->items.begin(), __system_menu_tree->items.end());
+			while(!stack.empty())
+			{
+				auto it = stack.back();
+				stack.pop_back();
+				if(!it) continue;
+				if(it->is_menu())
+				{
+					for(auto c : it->items) stack.push_back(c);
+					continue;
+				}
+				if(it->is_separator() || it->wid == 0 || it->wid == (uint32_t)-1)
+					continue;
+				if(it->uid() == uid)
+					return it;
+			}
+			return nullptr;
+		}
+
+		// Llamado por el timer y por WM_ENTERIDLE: actualiza el boton bajo el cursor.
+		void ContextMenu::toolbar_track()
+		{
+			if(_toolbars.empty()) return;
+
+			POINT pt{};
+			if(!::GetCursorPos(&pt)) return;
+
+			for(auto tb : _toolbars)
+			{
+				if(!tb || !::IsMenu(tb->handle)) continue;
+
+				auto index = MENU::get_index(tb->handle, tb->wID);
+				if(index == MF_NOITEM) continue;
+
+				RECT rc{};
+				if(!::GetMenuItemRect(nullptr, tb->handle, index, &rc)) continue;
+
+				int hot = ::PtInRect(&rc, pt) ? toolbar_hit(tb, rc, pt) : -1;
+				if(hot == tb->toolbar.hot) continue;
+				tb->toolbar.hot = hot;
+				if(hot < 0) _tip.hide();
+
+				// ventana del menu que contiene la barra
+				HWND hwndMenu{};
+				if(auto it = map_menu_wnd.find(tb->handle); it != map_menu_wnd.end())
+					hwndMenu = it->second.hwnd;
+				if(!hwndMenu)
+				{
+					for(auto &w : _map)
+					{
+						if(w.second.hMenu == tb->handle) { hwndMenu = w.first; break; }
+					}
+				}
+
+				if(hwndMenu)
+				{
+					::MapWindowPoints(HWND_DESKTOP, hwndMenu, reinterpret_cast<POINT *>(&rc), 2);
+					::InvalidateRect(hwndMenu, &rc, FALSE);
+				}
+			}
+		}
+
+		void ContextMenu::toolbar_stop()
+		{
+			if(hwnd.owner)
+				::KillTimer(hwnd.owner, TOOLBAR_TIMER);
+			_toolbars.clear();
+		}
+
+		void ContextMenu::draw_toolbar(DC &dc, MenuItemInfo *tb, const RECT &rcRow)
+		{
+			std::vector<RECT> btns;
+			toolbar_layout(tb, rcRow, btns);
+
+			const long isz = tb->toolbar.size;
+			const long cell = tb->toolbar.cell;
+
+			for(int i = 0; i < (int)btns.size(); i++)
+			{
+				auto child = tb->toolbar.items[i];
+				const RECT b = btns[i];
+				const bool hot = (i == tb->toolbar.hot);
+				const bool disabled = child->visibility != Visibility::Enabled;
+
+				Color text_color = hot ? _theme.text.color.sel : _theme.text.color.nor;
+				if(disabled) text_color = hot ? _theme.text.color.sel_dis : _theme.text.color.nor_dis;
+
+				if(hot)
+				{
+					Color back = disabled ? _theme.back.color.sel_dis : _theme.back.color.sel;
+					Color border = disabled ? _theme.back.border.sel_dis : _theme.back.border.sel;
+					draw_rect(&dc, POINT{ b.left, b.top }, SIZE{ cell, cell }, back, border, _theme.back.radius);
+				}
+
+				auto image = &child->image;
+				if(hot && child->image_select.isvalid())
+					image = &child->image_select;
+
+				if(image->hbitmap)
+				{
+					DC memDC(::CreateCompatibleDC(dc), 1);
+					if(memDC)
+					{
+						if(memDC.select_bitmap(image->hbitmap))
+						{
+							const long w = image->size.cx > 0 ? image->size.cx : isz;
+							const long h = image->size.cy > 0 ? image->size.cy : isz;
+							POINT p = { b.left + (cell - w) / 2, b.top + (cell - h) / 2 };
+							dc.draw_image(p, SIZE{ w, h }, memDC, disabled ? 64 : 255);
+							memDC.reset_bitmap();
+						}
+					}
+				}
+				else if(image->import == ImageImport::Draw && image->draw.type == image->draw.DT_GLYPH)
+				{
+					auto g = &image->draw.glyph;
+					if(g->font)
+					{
+						Color c0 = g->color[0], c1 = g->color[1];
+						if(!c0) c0 = _theme.image.color[0] ? _theme.image.color[0] : text_color;
+						if(!c1) c1 = _theme.image.color[0] ? _theme.image.color[1] : text_color;
+						if(disabled) { c0.opacities(); c1.opacities(); }
+
+						const Rect rcGlyph(b);
+						const DWORD fmt = DT_NOCLIP | DT_SINGLELINE | DT_VCENTER | DT_CENTER;
+						if(g->code[0])
+							draw_string(dc, g->font, &rcGlyph, c0, &g->code[0], 1, fmt);
+						if(g->code[1])
+							draw_string(dc, g->font, &rcGlyph, c1, &g->code[1], 1, fmt);
+					}
+				}
+			}
+
+			// tooltip del boton activo, junto al boton (coordenadas de pantalla)
+			const int hot = tb->toolbar.hot;
+			if(hot >= 0 && hot < (int)tb->toolbar.items.size() && tb->toolbar.items[hot]->tip)
+			{
+				auto index = MENU::get_index(tb->handle, tb->wID);
+				RECT rs{};
+				if(index != MF_NOITEM && ::GetMenuItemRect(nullptr, tb->handle, index, &rs))
+				{
+					std::vector<RECT> sbtns;
+					toolbar_layout(tb, rs, sbtns);
+					auto child = tb->toolbar.items[hot];
+					_tip.show(child->tip.text, child->tip.type, child->tip.time, Rect(sbtns[hot]));
+				}
+			}
+		}
