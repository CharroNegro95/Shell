+		// Rectangulos de los botones repartidos a lo ancho de la fila rc:
+		// la fila se divide en partes iguales (zones) y cada boton va centrado
+		// en la suya, asi la barra ocupa todo el ancho del menu.
+		void ContextMenu::toolbar_layout(const MenuItemInfo *tb, const RECT &rc, std::vector<RECT> &out, std::vector<RECT> *zones) const
+		{
+			out.clear();
+			if(zones) zones->clear();
+			const long n = (long)tb->toolbar.items.size();
+			if(n <= 0) return;
+
+			const long cell = tb->toolbar.cell;
+			const long left = rc.left + (long)_theme.back.margin.left;
+			const long right = rc.right - (long)_theme.back.margin.right;
+			const long y = rc.top + ((rc.bottom - rc.top) - cell) / 2;
+
+			long slot = (right - left) / n;
+			if(slot < cell) slot = cell;
+
+			for(long i = 0; i < n; i++)
+			{
+				const long zl = left + i * slot;
+				// sin std::max: windows.h define la macro max y rompe la llamada
+				const long zr = (i == n - 1 && right > zl + slot) ? right : zl + slot;
+				const long x = zl + ((zr - zl) - cell) / 2;
+				out.push_back(RECT{ x, y, x + cell, y + cell });
+				if(zones) zones->push_back(RECT{ zl, rc.top, zr, rc.bottom });
+			}
+		}
+
+		// Boton cuya zona contiene pt; -1 si ninguno.
+		int ContextMenu::toolbar_hit(const MenuItemInfo *tb, const RECT &rc, POINT pt) const
+		{
+			if(pt.y < rc.top || pt.y >= rc.bottom) return -1;
+			std::vector<RECT> btns, zones;
+			toolbar_layout(tb, rc, btns, &zones);
+			for(int i = 0; i < (int)zones.size(); i++)
+			{
+				if(pt.x >= zones[i].left && pt.x < zones[i].right)
+					return i;
+			}
+			return -1;
+		}
